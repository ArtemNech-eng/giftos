# Public URL of the Supabase-compatible API.
# Production: self-hosted Supabase deployed in a Russian data centre.
# Local development: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.ru
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never prefix this value with NEXT_PUBLIC and never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by auth redirects and payment webhook signatures.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment provider is deliberately not chosen at the foundation stage.
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=

# Self-hosted LiveKit/SFU in the Russian production contour.
# Leave empty during development: live rooms will show a graceful media placeholder.
LIVEKIT_URL=wss://live.example.ru
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Web push (VAPID). Generate keys:
#   npx web-push generate-vapid-keys
# Leave empty during development: push is skipped gracefully.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@hochutakzhe.ru
