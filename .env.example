# Public Supabase values: Settings → API in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never prefix this value with NEXT_PUBLIC and never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by auth redirects and payment webhook signatures.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment provider is deliberately not chosen at the foundation stage.
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=
